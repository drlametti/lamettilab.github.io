source "https://rubygems.org"

# GitHub Pages builds this site server-side. The github-pages gem pins the exact
# Jekyll version and plugin set GitHub uses, so local builds match production.
# It already bundles jekyll-remote-theme and jekyll-seo-tag — do not list those
# (or jekyll itself) separately, or Bundler cannot resolve the versions.
gem "github-pages", group: :jekyll_plugins

gem "webrick" # Required for Ruby 3.0+
